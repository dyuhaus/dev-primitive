{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyadmin.local/dev-primitive/roles.schema.json",
  "title": "Configurable Agent Framework",
  "description": "Planner and Builder are the legacy-compatible PB core. The optional agents registry defines specialist profiles.",
  "type": "object",
  "required": ["version", "roles", "providers"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "roles": {
      "type": "object",
      "required": ["planner", "builder"],
      "additionalProperties": { "$ref": "#/$defs/role" },
      "properties": {
        "planner": { "$ref": "#/$defs/role" },
        "builder": { "$ref": "#/$defs/role" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/agentProfile" }
    },
    "routing": { "$ref": "#/$defs/routing" },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["class", "provider"],
      "additionalProperties": true,
      "properties": {
        "class": { "type": "string", "minLength": 1 },
        "id": { "type": "string" },
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "role": {
      "type": "object",
      "required": ["purpose", "model"],
      "additionalProperties": true,
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/model" },
        "readOnly": { "type": "boolean" },
        "canDelegate": { "type": "boolean" },
        "delegateTo": { "$ref": "#/$defs/stringList" }
      }
    },
    "agentProfile": {
      "type": "object",
      "required": ["displayName", "purpose", "model", "readOnly", "tools", "invocation", "autoSelectEligible", "capabilities", "boundaries", "escalateTo", "canDelegate", "delegateTo", "outputContract", "infoSources"],
      "additionalProperties": true,
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/model" },
        "readOnly": { "type": "boolean" },
        "tools": { "$ref": "#/$defs/stringList" },
        "invocation": { "type": "string", "enum": ["default", "direct-call-only"] },
        "autoSelectEligible": { "type": "boolean" },
        "capabilities": { "$ref": "#/$defs/stringList" },
        "boundaries": { "$ref": "#/$defs/stringList" },
        "escalateTo": { "$ref": "#/$defs/stringList" },
        "canDelegate": { "type": "boolean" },
        "delegateTo": { "$ref": "#/$defs/stringList" },
        "outputContract": { "$ref": "#/$defs/stringList" },
        "infoSources": { "$ref": "#/$defs/stringList" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "planBeforeBuild": { "type": "boolean" },
        "inlineTrivial": { "type": "boolean" },
        "postWorkflowAudit": {
          "type": "object",
          "required": ["enabled", "model", "thinking"],
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "model": { "$ref": "#/$defs/model" },
            "thinking": { "type": "string", "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] }
          }
        },
        "note": { "type": "string" },
        "automaticSelection": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "status": { "type": "string" },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "fallback": { "type": "string", "minLength": 1 },
            "audit": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["type", "apiKeyEnv"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["anthropic", "openai", "google", "local"] },
        "apiKeyEnv": { "type": "string" },
        "baseUrlEnv": { "type": "string" }
      }
    }
  }
}
