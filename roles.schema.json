{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyadmin.local/dev-primitive/roles.schema.json",
  "title": "Dev Primitive Roles Config",
  "description": "Configuration for the two-role (planner/builder) development primitive. The exact model class for each role is customizable here and drives every harness adapter.",
  "type": "object",
  "required": ["version", "roles", "providers"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "roles": {
      "type": "object",
      "required": ["planner", "builder"],
      "additionalProperties": { "$ref": "#/$defs/role" },
      "properties": {
        "planner": { "$ref": "#/$defs/role" },
        "builder": { "$ref": "#/$defs/role" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "planBeforeBuild": { "type": "boolean" },
        "inlineTrivial": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": ["purpose", "model"],
      "additionalProperties": true,
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "readOnly": { "type": "boolean" },
        "model": {
          "type": "object",
          "required": ["class", "provider"],
          "additionalProperties": true,
          "properties": {
            "class": {
              "type": "string",
              "minLength": 1,
              "description": "The customizable model class/alias for this role (e.g. fable, opus, sonnet, or a provider-specific class). Resolves to the newest model in that family on harnesses that support aliases."
            },
            "id": {
              "type": "string",
              "description": "Optional exact model id to pin (e.g. claude-opus-4-8). When non-empty it overrides class for resolution."
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "description": "Key into the top-level providers map."
            }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["type", "apiKeyEnv"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["anthropic", "openai", "google", "local"],
          "description": "Wire protocol / SDK family the harness should use for this provider."
        },
        "apiKeyEnv": { "type": "string" },
        "baseUrlEnv": { "type": "string" }
      }
    }
  }
}
