{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyadmin.local/dev-primitive/roles.schema.json",
  "title": "Configurable Agent Framework",
  "description": "Planner and Builder are the legacy-compatible PB core. The optional agents registry defines specialist profiles.",
  "type": "object",
  "required": ["version", "roles", "providers"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "roles": {
      "type": "object",
      "required": ["planner", "builder"],
      "additionalProperties": { "$ref": "#/$defs/role" },
      "properties": {
        "planner": { "$ref": "#/$defs/role" },
        "builder": { "$ref": "#/$defs/role" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/agentProfile" }
    },
    "routing": { "$ref": "#/$defs/routing" },
    "providers": {
      "description": "Provider entries keyed by NAME. Consumers map a role to a harness by the provider's key, not by its declared type — Maestro's backend/lib/roles.js and dev-primitive's own adapters both do. The four recognised key names are 'anthropic' (-> Claude Code), 'openai' (-> Codex), 'deepseek' (-> dsh) and 'openrouter' (-> Pi). Any other key validates but is unroutable: a DeepSeek endpoint keyed 'dsh' passes every check here and is then silently marked unavailable by every consumer.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
      "additionalProperties": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "model": {
      "description": "A model selection. Schema-valid is not the same as dispatchable: whether a harness can actually run this model is an adapter property, checked at render time. Claude Code resolves Anthropic classes (opus, sonnet, haiku, fable) and claude-* ids and silently discards anything else, so apply.py refuses to render a Claude profile it cannot dispatch.",
      "type": "object",
      "required": ["class", "provider"],
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "openai" } }, "required": ["provider"] },
          "then": { "required": ["effort"] }
        }
      ],
      "additionalProperties": true,
      "properties": {
        "class": { "description": "Model class or alias; auto-upgrades where the harness supports aliases.", "type": "string", "minLength": 1 },
        "id": { "description": "Optional exact model id. When non-empty it wins over class.", "type": "string" },
        "provider": { "description": "A key into the providers map. Use a recognised key name; see providers.", "type": "string", "minLength": 1 },
        "effort": { "description": "Requested model reasoning effort.", "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] }
      }
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "role": {
      "type": "object",
      "required": ["purpose", "model"],
      "additionalProperties": true,
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/model" },
        "readOnly": { "type": "boolean" },
        "canDelegate": { "type": "boolean" },
        "delegateTo": { "$ref": "#/$defs/stringList" }
      }
    },
    "agentProfile": {
      "type": "object",
      "required": ["displayName", "purpose", "model", "readOnly", "tools", "invocation", "autoSelectEligible", "capabilities", "boundaries", "escalateTo", "canDelegate", "delegateTo", "outputContract", "infoSources"],
      "additionalProperties": true,
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/model" },
        "readOnly": { "type": "boolean" },
        "tools": { "$ref": "#/$defs/stringList" },
        "invocation": { "type": "string", "enum": ["default", "direct-call-only"] },
        "autoSelectEligible": { "type": "boolean" },
        "capabilities": { "$ref": "#/$defs/stringList" },
        "boundaries": { "$ref": "#/$defs/stringList" },
        "escalateTo": { "$ref": "#/$defs/stringList" },
        "canDelegate": { "type": "boolean" },
        "delegateTo": { "$ref": "#/$defs/stringList" },
        "outputContract": { "$ref": "#/$defs/stringList" },
        "infoSources": { "$ref": "#/$defs/stringList" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "planBeforeBuild": { "type": "boolean" },
        "inlineTrivial": { "type": "boolean" },
        "postWorkflowAudit": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "model": { "$ref": "#/$defs/model" },
            "thinking": { "type": "string", "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] }
          }
        },
        "note": { "type": "string" },
        "automaticSelection": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "status": { "type": "string" },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "fallback": { "type": "string", "minLength": 1 },
            "audit": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["type", "apiKeyEnv"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "description": "The wire protocol. Distinct from the provider's key name: the key decides which harness a role routes to, the type decides how a client talks to it.",
          "type": "string",
          "enum": ["anthropic", "openai", "google", "deepseek", "openrouter", "local"]
        },
        "apiKeyEnv": { "description": "NAME of the environment variable holding the key. Never a key value.", "type": "string" },
        "baseUrlEnv": { "description": "NAME of the environment variable holding the base URL, or an empty string.", "type": "string" }
      }
    }
  }
}
